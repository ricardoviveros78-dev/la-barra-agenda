<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>LA BARRA · Gestión de eventos</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{--bg:#101112;--panel:#191b1e;--panel2:#22252a;--line:#30343a;--text:#f4f4f2;--muted:#a4a8ae;--gold:#c7a66a;--green:#8fc49a;--red:#df8c8c}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px Inter,system-ui,Arial}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0;border-radius:10px;padding:10px 14px;background:var(--gold);color:#171717;font-weight:700}.secondary{background:#30343a;color:#fff}.danger{background:#642d2d;color:#fff}.ghost{background:transparent;color:var(--muted);border:1px solid var(--line)}button:disabled{opacity:.5;cursor:not-allowed}.wrap{max-width:1320px;margin:auto;padding:22px}.top{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:22px}.brand{font-size:28px;letter-spacing:5px;font-weight:850}.sub{color:var(--muted);font-size:11px;letter-spacing:2px}.nav{display:flex;gap:8px;flex-wrap:wrap;margin:20px 0}.nav button{background:transparent;color:var(--muted);border:1px solid var(--line)}.nav button.active{background:var(--gold);color:#171717;border-color:var(--gold)}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.stat,.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:17px}.stat small,.muted{color:var(--muted)}.stat strong{display:block;font-size:25px;margin-top:9px}.grid{display:grid;grid-template-columns:1.2fr .8fr;gap:14px;margin-top:14px}.panel h2{font-size:17px;margin:0 0 14px}.row{display:flex;align-items:center;justify-content:space-between;gap:12px}.event{padding:13px 0;border-top:1px solid var(--line)}.pill{font-size:11px;padding:5px 8px;border-radius:30px;background:#343b35;color:var(--green)}.empty{padding:25px;text-align:center;color:var(--muted)}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{display:flex;flex-direction:column;gap:6px}.field.full{grid-column:1/-1}.field label{font-size:12px;color:var(--muted)}input,select,textarea{width:100%;padding:11px;background:#111315;border:1px solid var(--line);border-radius:9px;color:var(--text)}textarea{min-height:75px;resize:vertical}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:620px}th,td{text-align:left;padding:10px;border-bottom:1px solid var(--line);vertical-align:middle}th{font-size:12px;color:var(--muted)}.hidden{display:none!important}.calendar{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}.day{min-height:85px;background:#111315;border:1px solid var(--line);border-radius:9px;padding:7px;font-size:12px}.day b{display:block;margin-bottom:5px}.day .dot{display:block;color:var(--gold);overflow:hidden;white-space:nowrap;text-overflow:ellipsis;cursor:pointer}.modal{position:fixed;inset:0;background:#000b;display:flex;align-items:center;justify-content:center;padding:15px;z-index:5}.modalbox{width:min(850px,100%);max-height:92vh;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:20px}.modalhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.file{padding:9px;border:1px solid var(--line);border-radius:9px;margin:7px 0;font-size:13px}.notice{font-size:12px;color:var(--muted);line-height:1.5;margin-top:18px}.status{font-size:12px;color:var(--muted);margin-top:8px}.login{max-width:440px;margin:9vh auto;background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:28px}.login .brand{margin-bottom:5px}.error{color:#ffaaaa}.success{color:var(--green)}.toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.inline{display:flex;gap:8px;align-items:center}.mini{padding:6px 9px;font-size:12px}.right{text-align:right}.gold{color:var(--gold)}
@media(max-width:760px){.wrap{padding:13px}.stats{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}.top{align-items:flex-start;flex-direction:column}.formgrid{grid-template-columns:1fr}.field.full{grid-column:auto}.day{min-height:66px;padding:5px;font-size:10px}.brand{font-size:24px}}
</style></head>
<body>
<section id="loginView" class="login">
  <div class="brand">LA BARRA</div><div class="sub">GESTIÓN DE EVENTOS</div><hr style="border:0;border-top:1px solid var(--line);margin:22px 0">
  <h2>Ingresar al sistema</h2><p class="muted">Acceso privado para el equipo de La Barra.</p>
  <form id="loginForm" class="formgrid" style="grid-template-columns:1fr">
    <div class="field"><label>Correo electrónico</label><input id="loginEmail" type="email" required value="ricardoviveros78@gmail.com"></div>
    <div class="field"><label>Contraseña</label><input id="loginPassword" type="password" required autocomplete="current-password"></div>
    <button id="loginBtn" type="submit">Ingresar</button>
  </form>
  <div class="actions"><button class="ghost" id="forgotBtn" type="button">Olvidé mi contraseña</button></div><div id="loginMsg" class="status"></div>
</section>
<main id="appView" class="wrap hidden">
<header class="top"><div><div class="brand">LA BARRA</div><div class="sub">GESTIÓN DE EVENTOS · SISTEMA EN LA NUBE</div><div id="userLine" class="status"></div></div><div class="toolbar"><button onclick="openEvent()">+ Nuevo evento</button><button class="secondary" onclick="refreshData()">↻ Actualizar</button><button class="ghost" onclick="signOut()">Salir</button></div></header>
<section class="stats"><div class="stat"><small>Eventos activos</small><strong id="sEvents">0</strong></div><div class="stat"><small>Reservas registradas</small><strong id="sRes">0</strong></div><div class="stat"><small>Entradas vendidas</small><strong id="sTickets">0</strong></div><div class="stat"><small>Ingresos registrados</small><strong id="sMoney">$0</strong></div></section>
<nav class="nav"><button class="active" onclick="tab('inicio',this)">Inicio</button><button onclick="tab('calendario',this)">Calendario</button><button onclick="tab('eventos',this)">Eventos</button><button onclick="tab('archivos',this)">Archivos</button></nav>
<section id="inicio"><div class="grid"><div class="panel"><h2>Próximas fechas</h2><div id="upcoming"></div></div><div class="panel"><h2>Accesos rápidos</h2><div class="actions"><button onclick="openEvent()">Crear evento</button><button class="secondary" onclick="tab('calendario')">Ver calendario</button></div><p class="notice">Cada fecha concentra banda, mesas, reservas, pagos, venta de entradas y documentación. La información se guarda en Supabase y se sincroniza al ingresar desde otro dispositivo.</p></div></div></section>
<section id="calendario" class="hidden"><div class="panel"><div class="row"><h2>Calendario de eventos</h2><input id="month" type="month" style="max-width:180px" onchange="renderCalendar()"></div><div id="calendar" class="calendar" style="margin-top:14px"></div></div></section>
<section id="eventos" class="hidden"><div class="panel"><div class="row"><h2>Todos los eventos</h2><button onclick="openEvent()">+ Nuevo</button></div><div id="allEvents"></div></div></section>
<section id="archivos" class="hidden"><div class="panel"><h2>Archivos de eventos</h2><p class="muted">Flyers, contratos, riders y documentos almacenados de forma privada en la nube.</p><div id="allFiles"></div></div></section>
</main>
<div id="modal" class="modal hidden"><div class="modalbox"><div class="modalhead"><h2 id="modalTitle">Detalle</h2><button class="secondary" onclick="closeModal()">Cerrar</button></div><div id="modalBody"></div></div></div>
<script>
const SUPABASE_URL='https://jvulmywtxpecpdxfkcol.supabase.co';
const SUPABASE_KEY='sb_publishable_koIrMGctpQ0E_Zn1Bt3HkQ_iECRNDJV';
const db=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);
const $=id=>document.getElementById(id);const money=n=>new Intl.NumberFormat('es-AR',{style:'currency',currency:'ARS',maximumFractionDigits:0}).format(Number(n)||0);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let me=null,profile=null,events=[],tables=[],reservations=[],payments=[],sales=[],files=[];let currentEvent=null;
function msg(id,t,cls=''){const e=$(id);e.textContent=t;e.className='status '+cls}
function canManage(){return ['administrador','organizador'].includes(profile?.role)}
async function signIn(ev){ev.preventDefault();$('loginBtn').disabled=true;msg('loginMsg','Ingresando...');try{const {data,error}=await db.auth.signInWithPassword({email:$('loginEmail').value.trim(),password:$('loginPassword').value});if(error)throw error;await showApp(data.user)}catch(e){msg('loginMsg',e.message||'No se pudo iniciar sesión.','error')}finally{$('loginBtn').disabled=false}}
async function forgotPassword(){const email=$('loginEmail').value.trim();if(!email){msg('loginMsg','Escribí tu correo para enviarte el enlace de recuperación.','error');return}const {error}=await db.auth.resetPasswordForEmail(email,{redirectTo:location.href});msg('loginMsg',error?error.message:'Te enviamos un correo para restablecer la contraseña.',error?'error':'success')}
async function signOut(){await db.auth.signOut();location.reload()}
async function boot(){const {data:{session}}=await db.auth.getSession();if(session)await showApp(session.user);db.auth.onAuthStateChange(async(_event,session)=>{if(session&&$('appView').classList.contains('hidden'))await showApp(session.user);else if(!session){$('appView').classList.add('hidden');$('loginView').classList.remove('hidden')}})}
async function showApp(user){me=user;const {data:p,error}=await db.from('lb_profiles').select('*').eq('id',user.id).maybeSingle();if(error)throw error;if(!p||!p.active){await db.auth.signOut();throw new Error('Tu usuario no tiene un perfil activo en LA BARRA. Contactá al administrador.')}profile=p;$('loginView').classList.add('hidden');$('appView').classList.remove('hidden');$('userLine').textContent=`${p.email} · ${p.role}`;await refreshData()}
async function refreshData(){try{const [a,b,c,d,e]=await Promise.all([db.from('lb_events').select('*').order('event_date'),db.from('lb_event_tables').select('*'),db.from('lb_reservations').select('*').order('created_at',{ascending:false}),db.from('lb_reservation_payments').select('*'),db.from('lb_ticket_sales').select('*')]);for(const x of [a,b,c,d,e])if(x.error)throw x.error;events=a.data||[];tables=b.data||[];reservations=c.data||[];payments=d.data||[];sales=e.data||[];const f=await db.from('lb_event_files').select('*').order('created_at',{ascending:false});if(f.error)throw f.error;files=f.data||[];render()}catch(e){alert('No se pudieron cargar los datos: '+(e.message||e))}}
function tab(id,btn){['inicio','calendario','eventos','archivos'].forEach(k=>$(k).classList.add('hidden'));$(id).classList.remove('hidden');document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));if(btn)btn.classList.add('active');if(id==='calendario')renderCalendar()}
function openModal(title,body){$('modalTitle').textContent=title;$('modalBody').innerHTML=body;$('modal').classList.remove('hidden')};function closeModal(){$('modal').classList.add('hidden')}
function openEvent(id){if(!canManage()){alert('Tu perfil no tiene permiso para gestionar eventos.');return}const e=events.find(x=>x.id===id)||{title:'',artist:'',event_date:'',start_time:'',venue:'La Barra',status:'pendiente',ticket_advance_price:0,ticket_door_price:0,capacity:'',notes:''};currentEvent=id||null;openModal(id?'Editar evento':'Crear evento',`<form id="eventForm" class="formgrid"><div class="field"><label>Nombre de la fecha *</label><input name="title" required value="${esc(e.title)}" placeholder="Ej. Viernes de música"></div><div class="field"><label>Banda / artista *</label><input name="artist" required value="${esc(e.artist)}"></div><div class="field"><label>Fecha *</label><input name="event_date" type="date" required value="${esc(e.event_date)}"></div><div class="field"><label>Horario</label><input name="start_time" type="time" value="${esc(e.start_time||'')}"></div><div class="field"><label>Lugar</label><input name="venue" value="${esc(e.venue||'La Barra')}"></div><div class="field"><label>Estado</label><select name="status">${[['pendiente','Pendiente'],['confirmado','Confirmado'],['realizado','Realizado'],['cancelado','Cancelado']].map(([v,l])=>`<option value="${v}" ${e.status===v?'selected':''}>${l}</option>`).join('')}</select></div><div class="field"><label>Entrada anticipada ($)</label><input name="ticket_advance_price" type="number" min="0" value="${+e.ticket_advance_price||0}"></div><div class="field"><label>Entrada en puerta ($)</label><input name="ticket_door_price" type="number" min="0" value="${+e.ticket_door_price||0}"></div><div class="field"><label>Capacidad general</label><input name="capacity" type="number" min="0" value="${e.capacity??''}"></div><div class="field full"><label>Notas / información adicional</label><textarea name="notes">${esc(e.notes||'')}</textarea></div><div class="field full"><button type="submit">Guardar evento</button></div></form>${id?`<div class="actions"><button class="secondary" onclick="openDetail('${id}')">Administrar evento</button><button class="danger" onclick="deleteEvent('${id}')">Eliminar evento</button></div>`:''}`);
$('eventForm').onsubmit=async ev=>{ev.preventDefault();const f=Object.fromEntries(new FormData(ev.target));f.ticket_advance_price=+f.ticket_advance_price;f.ticket_door_price=+f.ticket_door_price;f.capacity=f.capacity===''?null:+f.capacity;f.start_time=f.start_time||null;f.updated_at=new Date().toISOString();try{let q;if(id)q=await db.from('lb_events').update(f).eq('id',id);else q=await db.from('lb_events').insert({...f,created_by:me.id});if(q.error)throw q.error;closeModal();await refreshData()}catch(e){alert('Error al guardar evento: '+e.message)}}}
async function deleteEvent(id){if(!confirm('¿Eliminar este evento y todos sus datos relacionados?'))return;const {error}=await db.from('lb_events').delete().eq('id',id);if(error){alert(error.message);return}closeModal();await refreshData()}
function eventRelations(id){return {e:events.find(x=>x.id===id),t:tables.filter(x=>x.event_id===id),r:reservations.filter(x=>x.event_id===id),s:sales.filter(x=>x.event_id===id),f:files.filter(x=>x.event_id===id)}}
function paidFor(rid){return payments.filter(p=>p.reservation_id===rid).reduce((s,p)=>s+Number(p.amount),0)}
function openDetail(id){const {e,t,r,s,f}=eventRelations(id);if(!e)return;currentEvent=id;const totalRes=r.reduce((a,x)=>a+Number(x.total),0),paid=r.reduce((a,x)=>a+paidFor(x.id),0),ticketCount=s.reduce((a,x)=>a+Number(x.quantity),0),ticketIncome=s.reduce((a,x)=>a+Number(x.quantity)*Number(x.unit_price),0);openModal(e.title,`<div class="row"><div><b>${esc(e.artist)}</b><div class="muted">${esc(e.event_date)} · ${esc(e.start_time||'Horario a definir')} · ${esc(e.venue)}</div></div><span class="pill">${esc(e.status)}</span></div><div class="stats" style="margin-top:14px"><div class="stat"><small>Reservas</small><strong>${r.length}</strong></div><div class="stat"><small>Personas reservadas</small><strong>${r.reduce((a,x)=>a+Number(x.people),0)}</strong></div><div class="stat"><small>Entradas</small><strong>${ticketCount}</strong></div><div class="stat"><small>Recaudación</small><strong>${money(paid+ticketIncome)}</strong></div></div><div class="actions"><button onclick="addTable('${id}')">+ Configurar mesa</button><button onclick="addReservation('${id}')">+ Nueva reserva</button><button onclick="addTicketSale('${id}')">+ Venta de entradas</button><button class="secondary" onclick="generalReceipt('${id}')">Comprobante general</button></div><h3>Mesas</h3><div class="tablewrap"><table><tr><th>Mesa</th><th>Capacidad</th><th>Precio/persona</th><th></th></tr>${t.map(x=>`<tr><td>${esc(x.name)}</td><td>${x.capacity}</td><td>${money(x.price_per_person)}</td><td><button class="danger mini" onclick="removeTable('${x.id}','${id}')">Quitar</button></td></tr>`).join('')||'<tr><td colspan="4">No hay mesas configuradas.</td></tr>'}</table></div><h3>Reservas</h3><div class="tablewrap"><table><tr><th>Titular</th><th>Mesa</th><th>Personas</th><th>Total</th><th>Abonado</th><th>Saldo</th><th></th></tr>${r.map(x=>{const mesa=t.find(z=>z.id===x.table_id);const p=paidFor(x.id);return `<tr><td>${esc(x.customer_name)}<br><span class="muted">${esc(x.customer_phone||'')}</span></td><td>${esc(mesa?.name||'—')}</td><td>${x.people}</td><td>${money(x.total)}</td><td>${money(p)}</td><td>${money(Number(x.total)-p)}</td><td><button class="secondary mini" onclick="reservationReceipt('${x.id}')">PDF</button> <button class="mini" onclick="addPayment('${x.id}','${id}')">Abonar</button></td></tr>`}).join('')||'<tr><td colspan="7">Todavía no hay reservas.</td></tr>'}</table></div><h3>Ventas de entradas</h3><div class="tablewrap"><table><tr><th>Fecha</th><th>Cantidad</th><th>Precio</th><th>Canal</th><th>Total</th></tr>${s.map(x=>`<tr><td>${new Date(x.sold_at).toLocaleDateString('es-AR')}</td><td>${x.quantity}</td><td>${money(x.unit_price)}</td><td>${esc(x.channel)}</td><td>${money(x.quantity*x.unit_price)}</td></tr>`).join('')||'<tr><td colspan="5">Sin ventas registradas.</td></tr>'}</table></div><h3>Archivos y documentación</h3><div class="formgrid"><div class="field"><label>Archivo (máx. 15 MB)</label><input id="fileInput" type="file" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx"></div><div class="field"><label>Tipo de documento</label><select id="fileCategory"><option value="flyer">Flyer</option><option value="contrato">Contrato</option><option value="rider">Rider técnico</option><option value="lista_invitados">Lista de invitados</option><option value="comprobante">Comprobante</option><option value="presupuesto">Presupuesto</option><option value="otro">Otro</option></select></div></div><div class="actions"><button onclick="uploadEventFile('${id}')">Subir archivo</button></div>${f.map(x=>`<div class="file row"><span><b>${esc(x.file_name)}</b> · ${esc(x.category)}</span><button class="secondary mini" onclick="openEventFile('${x.id}')">Abrir</button></div>`).join('')||'<div class="muted">Todavía no hay archivos.</div>'}`)}
async function addTable(id){openModal('Configurar mesa',`<form id="tableForm" class="formgrid"><div class="field"><label>Nombre de mesa</label><input name="name" required placeholder="Mesa A"></div><div class="field"><label>Capacidad</label><input name="capacity" type="number" min="1" required value="10"></div><div class="field"><label>Precio por persona ($)</label><input name="price_per_person" type="number" min="0" required value="5000"></div><div class="field full"><label>Notas</label><input name="notes"></div><div class="field full"><button>Guardar mesa</button></div></form>`);$('tableForm').onsubmit=async ev=>{ev.preventDefault();const f=Object.fromEntries(new FormData(ev.target));f.event_id=id;f.capacity=+f.capacity;f.price_per_person=+f.price_per_person;const {error}=await db.from('lb_event_tables').insert(f);if(error){alert(error.message);return}await refreshData();openDetail(id)}}
async function removeTable(tableId,eventId){if(reservations.some(r=>r.table_id===tableId)){alert('No se puede quitar una mesa que tiene reservas.');return}if(!confirm('¿Quitar esta mesa?'))return;const {error}=await db.from('lb_event_tables').delete().eq('id',tableId);if(error){alert(error.message);return}await refreshData();openDetail(eventId)}
async function addReservation(id){const ts=tables.filter(x=>x.event_id===id);if(!ts.length){alert('Primero configurá al menos una mesa.');return}openModal('Nueva reserva',`<form id="resForm" class="formgrid"><div class="field"><label>Nombre del titular</label><input name="customer_name" required></div><div class="field"><label>Teléfono</label><input name="customer_phone"></div><div class="field"><label>Mesa</label><select name="table_id">${ts.map(t=>`<option value="${t.id}">${esc(t.name)} · ${money(t.price_per_person)} por persona · capacidad ${t.capacity}</option>`).join('')}</select></div><div class="field"><label>Cantidad de personas</label><input name="people" type="number" min="1" value="2" required></div><div class="field"><label>Abono inicial ($)</label><input name="paid" type="number" min="0" value="0"></div><div class="field"><label>Medio de pago</label><select name="method"><option value="efectivo">Efectivo</option><option value="transferencia">Transferencia</option><option value="mercado_pago">Mercado Pago</option><option value="tarjeta">Tarjeta</option><option value="otro">Otro</option></select></div><div class="field full"><label>Notas</label><textarea name="notes"></textarea></div><div class="field full"><button>Guardar reserva</button></div></form>`);$('resForm').onsubmit=async ev=>{ev.preventDefault();const f=Object.fromEntries(new FormData(ev.target));const table=ts.find(x=>x.id===f.table_id),people=+f.people,paid=+f.paid;if(people>table.capacity){alert('La cantidad supera la capacidad de la mesa.');return}if(paid>people*Number(table.price_per_person)){alert('El abono no puede superar el total de la reserva.');return}const payload={event_id:id,table_id:table.id,customer_name:f.customer_name,customer_phone:f.customer_phone||null,people,unit_price:Number(table.price_per_person),notes:f.notes||null,created_by:me.id};const {data,error}=await db.from('lb_reservations').insert(payload).select().single();if(error){alert(error.message);return}if(paid>0){const p=await db.from('lb_reservation_payments').insert({reservation_id:data.id,amount:paid,method:f.method,recorded_by:me.id});if(p.error){alert('La reserva se guardó, pero falló el abono: '+p.error.message)}}await refreshData();openDetail(id)}}
async function addPayment(rid,eid){openModal('Registrar abono',`<form id="paymentForm" class="formgrid"><div class="field"><label>Importe ($)</label><input name="amount" type="number" min="1" required></div><div class="field"><label>Medio de pago</label><select name="method"><option value="efectivo">Efectivo</option><option value="transferencia">Transferencia</option><option value="mercado_pago">Mercado Pago</option><option value="tarjeta">Tarjeta</option><option value="otro">Otro</option></select></div><div class="field full"><label>Referencia / observación</label><input name="reference"></div><div class="field full"><button>Guardar pago</button></div></form>`);$('paymentForm').onsubmit=async ev=>{ev.preventDefault();const f=Object.fromEntries(new FormData(ev.target));const {error}=await db.from('lb_reservation_payments').insert({reservation_id:rid,amount:+f.amount,method:f.method,reference:f.reference||null,recorded_by:me.id});if(error){alert(error.message);return}await refreshData();openDetail(eid)}}
async function addTicketSale(id){openModal('Registrar venta de entradas',`<form id="ticketForm" class="formgrid"><div class="field"><label>Cantidad</label><input name="quantity" type="number" min="1" value="1" required></div><div class="field"><label>Precio por entrada ($)</label><input name="unit_price" type="number" min="0" value="0" required></div><div class="field"><label>Canal</label><select name="channel"><option value="anticipada">Anticipada</option><option value="puerta">Puerta</option><option value="online">Online</option><option value="invitacion">Invitación</option></select></div><div class="field"><label>Medio de pago</label><select name="method"><option value="efectivo">Efectivo</option><option value="transferencia">Transferencia</option><option value="mercado_pago">Mercado Pago</option><option value="tarjeta">Tarjeta</option><option value="otro">Otro</option></select></div><div class="field"><label>Cliente (opcional)</label><input name="customer_name"></div><div class="field"><label>Teléfono (opcional)</label><input name="customer_phone"></div><div class="field full"><button>Guardar venta</button></div></form>`);$('ticketForm').onsubmit=async ev=>{ev.preventDefault();const f=Object.fromEntries(new FormData(ev.target));const {error}=await db.from('lb_ticket_sales').insert({event_id:id,quantity:+f.quantity,unit_price:+f.unit_price,channel:f.channel,method:f.method,customer_name:f.customer_name||null,customer_phone:f.customer_phone||null,recorded_by:me.id});if(error){alert(error.message);return}await refreshData();openDetail(id)}}
async function uploadEventFile(id){const file=$('fileInput').files[0];if(!file){alert('Seleccioná un archivo.');return}if(file.size>15*1024*1024){alert('El archivo supera los 15 MB.');return}const safe=file.name.replace(/[^a-zA-Z0-9._-]/g,'_');const path=`${id}/${crypto.randomUUID()}-${safe}`;const up=await db.storage.from('la-barra-eventos').upload(path,file,{upsert:false,contentType:file.type||'application/octet-stream'});if(up.error){alert('Error al subir archivo: '+up.error.message);return}const {error}=await db.from('lb_event_files').insert({event_id:id,file_name:file.name,storage_path:path,mime_type:file.type,size_bytes:file.size,category:$('fileCategory').value,uploaded_by:me.id});if(error){await db.storage.from('la-barra-eventos').remove([path]);alert(error.message);return}await refreshData();openDetail(id)}
async function openEventFile(fileId){const f=files.find(x=>x.id===fileId);if(!f)return;const {data,error}=await db.storage.from('la-barra-eventos').createSignedUrl(f.storage_path,300);if(error){alert(error.message);return}window.open(data.signedUrl,'_blank','noopener')}
function printDoc(title,html){const w=window.open('','_blank');if(!w){alert('Permití las ventanas emergentes para generar el comprobante.');return}w.document.write(`<!doctype html><html><head><title>${esc(title)}</title><meta charset="utf-8"><style>body{font:14px Arial;padding:32px;color:#222}h1{letter-spacing:5px}table{width:100%;border-collapse:collapse;margin-top:18px}td,th{padding:9px;border-bottom:1px solid #ddd;text-align:left}button{padding:10px 14px;margin-top:20px}@media print{button{display:none}}</style></head><body>${html}<button onclick="window.print()">Imprimir / Guardar PDF</button></body></html>`);w.document.close()}
function reservationReceipt(rid){const r=reservations.find(x=>x.id===rid);if(!r)return;const e=events.find(x=>x.id===r.event_id),t=tables.find(x=>x.id===r.table_id),paid=paidFor(r.id);printDoc('Comprobante de reserva',`<h1>LA BARRA</h1><p>COMPROBANTE INDIVIDUAL DE RESERVA</p><hr><h2>${esc(e?.title)}</h2><p>Artista: ${esc(e?.artist)}<br>Fecha: ${esc(e?.event_date)} · ${esc(e?.start_time||'Horario a definir')}</p><hr><p>Titular: <b>${esc(r.customer_name)}</b><br>Teléfono: ${esc(r.customer_phone||'—')}<br>Mesa: ${esc(t?.name||'—')}<br>Personas: ${r.people}<br>Precio por persona: ${money(r.unit_price)}</p><h2>Total: ${money(r.total)}</h2><p>Abonado: ${money(paid)}<br>Saldo pendiente: ${money(Number(r.total)-paid)}</p><p>Estado: ${esc(r.status)}</p><p>LA BARRA · Comprobante informativo</p>`)}
function generalReceipt(id){const {e,t,r,s}=eventRelations(id);const rows=r.map(x=>{const mesa=t.find(z=>z.id===x.table_id);const paid=paidFor(x.id);return `<tr><td>${esc(mesa?.name)} · ${esc(x.customer_name)}</td><td>${x.people}</td><td>${money(x.total)}</td><td>${money(paid)}</td><td>${money(Number(x.total)-paid)}</td></tr>`}).join('');const totalRes=r.reduce((a,x)=>a+Number(x.total),0),paid=r.reduce((a,x)=>a+paidFor(x.id),0),ticketQty=s.reduce((a,x)=>a+Number(x.quantity),0),ticketMoney=s.reduce((a,x)=>a+Number(x.quantity)*Number(x.unit_price),0);printDoc('Comprobante general',`<h1>LA BARRA</h1><p>COMPROBANTE GENERAL DE EVENTO</p><hr><h2>${esc(e.title)}</h2><p>Artista: ${esc(e.artist)}<br>Fecha: ${esc(e.event_date)} · ${esc(e.start_time||'Horario a definir')}<br>Lugar: ${esc(e.venue)}</p><h3>Reservas</h3><table><tr><th>Detalle</th><th>Personas</th><th>Total</th><th>Abonado</th><th>Saldo</th></tr>${rows}</table><p>Total reservas: ${money(totalRes)}<br>Abonado reservas: ${money(paid)}<br>Saldo pendiente: ${money(totalRes-paid)}<br>Entradas vendidas: ${ticketQty}<br>Recaudación entradas: ${money(ticketMoney)}</p><h2>INGRESOS REGISTRADOS: ${money(paid+ticketMoney)}</h2><p>Documento informativo · La Barra</p>`)}
async function removeFile(fileId,eventId){const f=files.find(x=>x.id===fileId);if(!f||!confirm('¿Eliminar este archivo?'))return;const a=await db.storage.from('la-barra-eventos').remove([f.storage_path]);if(a.error){alert(a.error.message);return}const b=await db.from('lb_event_files').delete().eq('id',fileId);if(b.error){alert(b.error.message);return}await refreshData();openDetail(eventId)}
function renderCalendar(){const v=$('month').value||new Date().toISOString().slice(0,7);$('month').value=v;const [y,m]=v.split('-').map(Number),first=new Date(y,m-1,1),offset=(first.getDay()+6)%7,days=new Date(y,m,0).getDate();let s=['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'].map(x=>`<div class="muted">${x}</div>`).join('');for(let i=0;i<offset;i++)s+='<div></div>';for(let d=1;d<=days;d++){const key=`${y}-${String(m).padStart(2,'0')}-${String(d).padStart(2,'0')}`;const evs=events.filter(e=>e.event_date===key);s+=`<div class="day"><b>${d}</b>${evs.map(e=>`<span class="dot" onclick="openDetail('${e.id}')">• ${esc(e.title)}</span>`).join('')}</div>`}$('calendar').innerHTML=s}
function render(){const sorted=[...events].sort((a,b)=>a.event_date.localeCompare(b.event_date));const active=sorted.filter(e=>e.status!=='cancelado');$('sEvents').textContent=active.length;$('sRes').textContent=reservations.filter(r=>r.status!=='cancelada').length;$('sTickets').textContent=sales.reduce((a,x)=>a+Number(x.quantity),0);const inc=payments.reduce((a,x)=>a+Number(x.amount),0)+sales.reduce((a,x)=>a+Number(x.quantity)*Number(x.unit_price),0);$('sMoney').textContent=money(inc);$('upcoming').innerHTML=active.slice(0,6).map(e=>`<div class="event row"><div><b>${esc(e.title)}</b><div class="muted">${esc(e.event_date)} · ${esc(e.artist)}</div></div><button class="secondary mini" onclick="openDetail('${e.id}')">Abrir</button></div>`).join('')||'<div class="empty">Todavía no hay eventos cargados.</div>';$('allEvents').innerHTML=sorted.map(e=>`<div class="event row"><div><b>${esc(e.title)}</b><div class="muted">${esc(e.event_date)} · ${esc(e.artist)} · ${esc(e.venue)}</div></div><div class="actions"><span class="pill">${esc(e.status)}</span><button class="secondary mini" onclick="openEvent('${e.id}')">Editar</button><button class="mini" onclick="openDetail('${e.id}')">Administrar</button></div></div>`).join('')||'<div class="empty">Creá tu primer evento.</div>';$('allFiles').innerHTML=files.map(f=>{const e=events.find(x=>x.id===f.event_id);return `<div class="file row"><span><b>${esc(f.file_name)}</b><br><span class="muted">${esc(e?.title||'Evento')} · ${esc(f.category)}</span></span><button class="secondary mini" onclick="openEventFile('${f.id}')">Abrir</button></div>`}).join('')||'<div class="empty">No hay archivos adjuntos.</div>';if(!$('calendario').classList.contains('hidden'))renderCalendar()}
$('loginForm').addEventListener('submit',signIn);$('forgotBtn').addEventListener('click',forgotPassword);$('month').value=new Date().toISOString().slice(0,7);boot().catch(e=>msg('loginMsg',e.message||'Error al iniciar la aplicación.','error'));
